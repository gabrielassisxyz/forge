#!/usr/bin/env bash
# forge-loop — the autonomous implementation loop (a Ralph loop with a verifier).
#
# ONE task per iteration. Fresh agent context each time; state lives on disk
# (task_plan.md / findings.md / progress.md), never in a long-lived session.
#
# The single reason this exists instead of the plain Ralph one-liner:
#   implementer and verifier are DIFFERENT invocations. The implementer never
#   grades its own homework — a separate checker, default stance REJECT, gates
#   every task. That split is what turns "compiles" into "actually works", which
#   is the whole point (make-it-work quality, not a raw prototype).
#
# Quality comes from FOUR backpressure layers, not from the prompt:
#   1. AGENTS.md in the project   — direction the implementer must follow
#   2. the project's bin/ci       — deterministic gate (tests/lint/build)
#   3. the verifier agent         — semantic gate (did it do the task? stubs?)
#   4. the per-task retry cap      — bounded fix loop, then escalate to a human
#
# Everything is pluggable via env so forge is agent-CLI-agnostic. See README.

set -euo pipefail

# ---- configuration (override via env) --------------------------------------

PROJECT_DIR="$(realpath "${1:-$(pwd)}")"
FORGE_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# How to invoke a coding agent non-interactively. It runs with the project dir
# as CWD, takes the prompt as its last ARGUMENT, and has filesystem+tool access so
# it reads task_plan.md itself (we do NOT re-embed files every turn — cheaper stack).
#
# IMPLEMENTER — the cheaper/faster model does the grind. Default: Kimi K2.7 via pi
#   (`-a` trusts project-local files; `-p` = process and exit). For the code-tuned
#   variant swap the model for `openrouter/moonshotai/kimi-k2.7-code`.
FORGE_AGENT_CMD="${FORGE_AGENT_CMD:-pi -p -a --model litellm/kimi-k2.7}"

# VERIFIER — deliberately separable so a STRONGER model grades the implementer's
# work (the maker/checker split at the CLI, per the anti-slop rationale). Default:
# Opus via Claude Code. Pin the exact build with `--model claude-opus-4-8` if you
# want reproducible reviews. Set equal to FORGE_AGENT_CMD for single-agent mode.
FORGE_VERIFY_CMD="${FORGE_VERIFY_CMD:-claude -p --model opus --dangerously-skip-permissions}"

# Optional sandbox wrapper (e.g. ai-jail) prefixed to every agent call. An
# unattended agent that can rm -rf your home is a bad night; wrap it. Empty = off.
FORGE_SANDBOX="${FORGE_SANDBOX:-}"

FORGE_MAX_LOOPS="${FORGE_MAX_LOOPS:-40}"      # global iteration ceiling
FORGE_MAX_RETRIES="${FORGE_MAX_RETRIES:-3}"   # verifier rejects per task before escalate

# Per-agent-call wall-clock ceiling. A model call can stall with the connection
# open and no tokens arriving (seen with Ollama Cloud) — nothing else times it out,
# so without this a single hung invocation blocks the loop forever. A timed-out call
# becomes a failed attempt (partial work stays on disk; the retry continues it).
# Tasks average a few minutes, so 600s is generous headroom, not a tight leash.
FORGE_AGENT_TIMEOUT="${FORGE_AGENT_TIMEOUT:-600}"

# Run state lives OUTSIDE the project — the implementer modifies the repo (and will
# run `git clean -fdx` / `go clean` to reset build artifacts), which would delete an
# in-repo `.forge/` mid-run and take the loop's own log/state with it (it did). Keeping
# state out of the tree also stops it polluting the tool's git history. Override with
# FORGE_STATE_HOME. Keyed by project basename.
RUN_DIR="${FORGE_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}/forge}/$(basename "$PROJECT_DIR")"
LOG="${RUN_DIR}/forge.log"
mkdir -p "$RUN_DIR"

# ---- helpers ----------------------------------------------------------------

# Never let a logging failure abort the run (set -e): recreate the dir defensively
# and swallow any error — a lost log line must not kill an in-flight build.
log() { mkdir -p "$RUN_DIR" 2>/dev/null; { echo "[$(date '+%H:%M:%S')] $*" | tee -a "$LOG"; } || true; }

# Machine-readable event stream — one JSON object per line, the spine a future
# dashboard (live agent stream, stuck-run inspector) reads without parsing prose.
# event <type> [key=value ...]; values are single-line and minimally escaped.
EVENTS="${RUN_DIR}/events.jsonl"
event() {
  local type="$1"; shift
  local ts kv="" pair k v
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  for pair in "$@"; do
    k="${pair%%=*}"; v="${pair#*=}"
    v="${v//\\/\\\\}"; v="${v//\"/\\\"}"; v="${v//$'\n'/ }"; v="${v//$'\t'/ }"
    kv+=",\"$k\":\"$v\""
  done
  { printf '{"ts":"%s","iteration":%s,"event":"%s"%s}\n' "$ts" "${loop:-0}" "$type" "$kv" >> "$EVENTS"; } 2>/dev/null || true
}

# Run the agent with the given prompt as its trailing argument (portable across
# pi/claude/opencode — stdin is not universally read in print mode). Captures
# output to a file and echoes it so callers can grep for sentinels.
run_agent() {
  local cmd="$1" prompt="$2" outfile="$3" phase="${4:-agent}" rc=0 start hb
  mkdir -p "$(dirname "$outfile")"; : > "$outfile"   # defensive; state lives outside the repo
  start=$(date +%s)
  # Heartbeat: while the call runs, log liveness every FORGE_HEARTBEAT seconds, so a
  # stall shows up in the log itself instead of needing a by-hand `ps`/`/proc` dig.
  ( while sleep "${FORGE_HEARTBEAT:-60}"; do
      log "    … still in $phase — $(( $(date +%s) - start ))s, $(wc -c < "$outfile" 2>/dev/null || echo 0)B out"
    done ) & hb=$!
  # `timeout -k 10` sends SIGTERM at the ceiling, then SIGKILL 10s later if it clings.
  # Word-splitting of the sandbox/agent commands is intentional — they carry args.
  # shellcheck disable=SC2086
  ( cd "$PROJECT_DIR" && timeout -k 10 "$FORGE_AGENT_TIMEOUT" $FORGE_SANDBOX $cmd "$prompt" ) \
    > "$outfile" 2>&1 || rc=$?
  kill "$hb" 2>/dev/null || true; wait "$hb" 2>/dev/null || true
  AGENT_DURATION=$(( $(date +%s) - start ))
  AGENT_TIMED_OUT=$(( rc == 124 ? 1 : 0 ))
  (( AGENT_TIMED_OUT )) && log "  (agent TIMED OUT after ${FORGE_AGENT_TIMEOUT}s — counts as a failed attempt)"
  cat "$outfile" >> "$LOG"
}

# Always emit exactly one integer. `grep -c` prints "0" AND exits 1 on zero matches,
# so a naive `|| echo 0` would print "0\n0" and break every arithmetic test that uses
# it — which misfires precisely when the LAST task completes (remaining hits 0).
tasks_remaining() { local n; n=$(grep -cE '^\s*-?\s*\[ \]' "$PROJECT_DIR/task_plan.md" 2>/dev/null) || true; echo "${n:-0}"; }

escalate() {
  local reason="$1"
  log "STUCK — $reason"
  event escalate reason="$reason"
  # Revert optimistic checkbox marks: the implementer may have marked the failed task
  # [x] before the verifier rejected it. Restoring task_plan.md to the last committed
  # state (the last ACCEPTED task) drops those false "done" marks, so the plan never
  # claims a rejected task is finished. Accepted marks are already committed, untouched.
  git -C "$PROJECT_DIR" checkout -- task_plan.md 2>/dev/null || true
  { echo "# forge escalation"; echo; echo "**Reason:** $reason"; echo;
    echo "See task_plan.md / progress.md / the run log under \$FORGE_STATE_HOME."; } > "$RUN_DIR/STUCK.md"
  echo "STUCK" > "$RUN_DIR/sentinel"
  exit 1
}

# ---- prompts ----------------------------------------------------------------

IMPLEMENT_PROMPT="$(cat "$FORGE_HOME/prompts/implement.md")"
VERIFY_PROMPT="$(cat "$FORGE_HOME/prompts/verify.md")"

# ---- preflight --------------------------------------------------------------

[[ -f "$PROJECT_DIR/task_plan.md" ]] || escalate "no task_plan.md in $PROJECT_DIR"
[[ -f "$PROJECT_DIR/AGENTS.md" ]] || log "WARN: no AGENTS.md — implementer has no direction; quality will suffer"
command -v git >/dev/null && [[ -d "$PROJECT_DIR/.git" ]] || escalate "project must be a git repo (per-task commits are the review surface)"

log "forge-loop starting in $PROJECT_DIR"
log "implement: $FORGE_AGENT_CMD"
log "verify:    $FORGE_VERIFY_CMD"
log "sandbox: ${FORGE_SANDBOX:-none}  max_loops: $FORGE_MAX_LOOPS  retries/task: $FORGE_MAX_RETRIES"

# ---- the loop ---------------------------------------------------------------

loop=0
while (( loop < FORGE_MAX_LOOPS )); do
  (( ++loop ))
  remaining="$(tasks_remaining)"
  log "=== iteration $loop — $remaining task(s) left ==="
  (( remaining == 0 )) && { log "DONE — no [ ] tasks remain"; event finished; echo "DONE" > "$RUN_DIR/sentinel"; break; }

  # The task under work this iteration — logging its text makes the log self-explaining
  # ("iteration 6" alone told you nothing about WHAT was being built).
  task="$(grep -m1 -E '^\s*-?\s*\[ \]' "$PROJECT_DIR/task_plan.md" | sed -E 's/^\s*-?\s*\[ \]\s*//')"
  log "  task: ${task:0:110}"
  event iteration_start remaining="$remaining" task="${task:0:200}"

  iter="$RUN_DIR/iter-$loop"

  # 1) IMPLEMENT one task, with a bounded verifier-driven retry cycle.
  attempt=0 accepted=0 feedback=""
  while (( attempt < FORGE_MAX_RETRIES )); do
    (( ++attempt ))
    log "  implement (attempt $attempt/$FORGE_MAX_RETRIES)"
    run_agent "$FORGE_AGENT_CMD" "${IMPLEMENT_PROMPT}${feedback:+

## Reviewer rejected the previous attempt — address this specifically:
$feedback}" "${iter}-impl-$attempt.out" "implement"
    log "  implement done (${AGENT_DURATION}s)"
    event implement attempt="$attempt" dur="$AGENT_DURATION" timedout="$AGENT_TIMED_OUT"

    # 1a) The implementer hit a decision the plan doesn't cover. Escalate NOW rather
    #     than let it guess — guessing is the comprehension debt we exist to avoid.
    #     Don't burn the retry budget on a question only the human can answer.
    if grep -qx '##STUCK##' "${iter}-impl-$attempt.out"; then
      escalate "implementer needs a decision the plan doesn't cover (iteration $loop) — see findings.md"
    fi

    # 1b) Timed out mid-task → straight to retry. A truncated attempt must NOT reach
    #     ci/verify: the partial work can spuriously compile and a verifier reviewing
    #     it as a finished submission can wrongly ACCEPT incomplete code (it did).
    if (( AGENT_TIMED_OUT )); then
      feedback="Your previous attempt hit the ${FORGE_AGENT_TIMEOUT}s time limit before finishing. The partial work is on disk — CONTINUE and complete the task (do not restart from scratch)."
      log "  timed out mid-task — retrying (continues the partial work)"
      continue
    fi

    # 2) Deterministic gate: the project's own CI, if it has one.
    if [[ -x "$PROJECT_DIR/bin/ci" ]]; then
      log "  bin/ci"
      if ! ( cd "$PROJECT_DIR" && ./bin/ci ) >"${iter}-ci-$attempt.out" 2>&1; then
        feedback="bin/ci failed:
$(tail -n 30 "${iter}-ci-$attempt.out")"
        log "  bin/ci FAILED — feeding back"
        event ci attempt="$attempt" result=fail
        continue
      fi
      event ci attempt="$attempt" result=pass
    fi

    # 3) Semantic gate: a FRESH agent whose default answer is REJECT.
    log "  verify"
    run_agent "$FORGE_VERIFY_CMD" "$VERIFY_PROMPT" "${iter}-verify-$attempt.out" "verify"
    if grep -qx '##ACCEPT##' "${iter}-verify-$attempt.out"; then
      log "  verify → ACCEPT (${AGENT_DURATION}s)"
      event verify attempt="$attempt" result=accept dur="$AGENT_DURATION"
      accepted=1; break
    fi
    feedback="$(sed -n 's/^##REJECT##[: ]*//p;/^##REJECT##/,$p' "${iter}-verify-$attempt.out" | tail -n 40)"
    # Surface the first concrete reason in the log so "why did it reject?" needs no dig.
    reject1="$(printf '%s' "$feedback" | grep -m1 -E '[[:alnum:]]')"
    log "  verify → REJECT (${AGENT_DURATION}s): ${reject1:0:120}"
    event verify attempt="$attempt" result=reject dur="$AGENT_DURATION" reason="${reject1:0:200}"
  done

  (( accepted == 1 )) || escalate "task failed verification after $FORGE_MAX_RETRIES attempts (iteration $loop)"

  # 4) Commit the accepted task — this diff is the human's review surface later.
  ( cd "$PROJECT_DIR" && git add -A && \
    git commit -q -m "forge: iteration $loop" --no-verify ) || log "  (nothing to commit)"
  log "  task accepted + committed"
  event task_committed task="${task:0:200}" attempts="$attempt"

  # Guard against a stuck plan: agent claimed progress but no checkbox moved.
  (( "$(tasks_remaining)" < remaining )) || escalate "no task_plan.md checkbox advanced in iteration $loop (loop would spin)"
done

(( loop >= FORGE_MAX_LOOPS )) && escalate "hit FORGE_MAX_LOOPS ($FORGE_MAX_LOOPS)"

log "forge-loop finished — run 'bin/forge graduate $PROJECT_DIR' for the review gate"
