#!/usr/bin/env bash
# forge — turn a raw idea into a usable v1 tool, mostly autonomously.
#
# The pipeline is deliberately a thin orchestration of steps. Steps 1-4 are
# agent-driven planning with a human confirm between each (cheap tokens, high
# leverage — this is where quality is decided). Step 5 is the unattended loop.
# Step 7 is the review gate that hands YOU a diff to read.
#
#   1 interview   -> IDEA.md        (product interview; the entry gate)
#   2 bootstrap   -> AGENTS.md, bin/ci, gitleaks   (via the project-bootstrap skill)
#   3 scope       -> SCOPE.md       (cut v1 hard)
#   4 plan        -> task_plan.md + findings.md + progress.md
#   5 loop        -> forge-loop     (implement + verify, one task per iteration)
#   7 graduate    -> GRADUATION.md  (the human review gate: is it usable?)
#
# Steps 1,3,4 print the prompt to run through your coding agent (they are
# interactive by design — you confirm each artifact). Step 5 is `forge-loop`.

set -euo pipefail
FORGE_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
forge — turn a raw idea into a usable v1 tool, mostly autonomously.

MANUAL — you gate each (or run the /forge-new skill to do all four in one session):
  1 interview   -> IDEA.md        product interview; the entry gate
  2 bootstrap   -> AGENTS.md, bin/ci, gitleaks   (run the project-bootstrap skill)
  3 scope       -> SCOPE.md       cut v1 hard (the WHAT)
  4 plan        -> PLAN.md        architecture / the HOW — your technical gate
AUTONOMOUS:
  5 loop        -> forge-loop     cuts PLAN into tasks, reviews the cut, then builds
  7 graduate    -> GRADUATION.md  the human review gate: is it usable?

Usage: forge <interview|scope|plan|loop|graduate> [project-dir]
       forge new <name>          scaffold a project dir with the 3-file spine
EOF
  exit "${1:-0}"
}

show_prompt() { echo "── run this through your coding agent in the project dir ──"; echo;
                cat "$FORGE_HOME/prompts/$1"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  interview) show_prompt interview.md ;;
  scope)     show_prompt vision-scope.md ;;
  plan)      show_prompt plan.md ;;          # the manual HOW step; the autonomous cut lives in the loop

  new)
    name="${1:?forge new <name>}"; dir="$(realpath "$name")"
    mkdir -p "$dir"; ( cd "$dir" && git init -q 2>/dev/null || true )
    for f in task_plan findings progress; do
      [[ -f "$dir/$f.md" ]] || sed "s/<project>/$(basename "$dir")/" "$FORGE_HOME/templates/$f.md" > "$dir/$f.md"
    done
    echo "Scaffolded $dir. Next: forge interview, then project-bootstrap, then scope/plan, then loop." ;;

  loop)      exec "$FORGE_HOME/bin/forge-loop" "${1:-$(pwd)}" ;;

  graduate)
    # Step 7 — the review gate. Not "is it perfect", but: is it USABLE, and is the
    # comprehension debt payable by READING (not rewriting)? Produces the surface
    # you actually review. Never auto-approves; that judgement is yours.
    dir="$(realpath "${1:-$(pwd)}")"; report="$dir/GRADUATION.md"
    {
      echo "# Graduation report — $(basename "$dir")"
      echo; echo "_Generated $(date '+%Y-%m-%d %H:%M')._ Read this, then read the diff."
      echo; echo "## Plan completion"
      echo '```'; grep -E '^\s*-?\s*\[[ x]\]' "$dir/task_plan.md" 2>/dev/null || echo "(no task_plan.md)"; echo '```'
      echo; echo "## CI"
      if [[ -x "$dir/bin/ci" ]]; then
        if ( cd "$dir" && ./bin/ci ) >/tmp/forge-ci.$$ 2>&1; then echo "PASS"; else echo "FAIL — see below"; fi
        echo '```'; tail -n 25 /tmp/forge-ci.$$ 2>/dev/null; echo '```'; rm -f /tmp/forge-ci.$$
      else echo "(no bin/ci)"; fi
      echo; echo "## Commits (the review surface)"
      echo '```'; ( cd "$dir" && git log --oneline -20 2>/dev/null ) || true; echo '```'
      echo; echo "## Your gate"
      echo "- [ ] Ran the tool — the done-check from IDEA.md passes"
      echo "- [ ] Read the diff — I understand it (reading, not rewriting)"
      echo "- [ ] Usable now; improvements go to v2 as refactor, not a rebuild"
    } > "$report"
    echo "Wrote $report"; echo "Review it, then run the tool yourself before you trust it." ;;

  ""|-h|--help) usage 0 ;;
  *) echo "unknown command: $cmd" >&2; usage 1 ;;
esac
