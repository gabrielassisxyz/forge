#!/usr/bin/env bash
# The deterministic gate for this repo, runnable locally — run it before any PR.
# forge is a few shell scripts + prompt files, so the gates are: shell scripts
# lint clean, and no secrets.
set -euo pipefail

cd "$(dirname "$0")/.."
fail=0

echo "==> shellcheck (shell lint)"
if command -v shellcheck >/dev/null 2>&1; then
    # All tracked shell scripts: bin/ and the versioned git hooks. Selected by
    # shebang, not by path, so a non-shell tool landing in bin/ later does not
    # make shellcheck error out on it.
    mapfile -t candidates < <(git ls-files 'bin/*' '.githooks/*')
    scripts=()
    for candidate in "${candidates[@]}"; do
        case "$(head -1 "$candidate")" in
            '#!'*sh|'#!'*sh\ *) scripts+=("$candidate") ;;
        esac
    done
    if [ ${#scripts[@]} -gt 0 ]; then
        shellcheck "${scripts[@]}" || fail=1
    fi
else
    echo "shellcheck not installed — see https://www.shellcheck.net" >&2
    fail=1
fi

echo "==> gitleaks (secret scan)"
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --no-banner --redact . || fail=1
else
    echo "gitleaks not installed — see https://github.com/gitleaks/gitleaks" >&2
    fail=1
fi

# anti-slop gate: em-dash in prose + the tool-name leak. Canonical: llm-workflow bin/slop-guard.
echo "==> slop-guard"; bin/slop-guard --diff "${SLOP_GUARD_BASE:-origin/master}" || fail=1

if [ "$fail" -ne 0 ]; then
    echo "==> bin/ci FAILED"
    exit 1
fi
echo "==> bin/ci OK"
